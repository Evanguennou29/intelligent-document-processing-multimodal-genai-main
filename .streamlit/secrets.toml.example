# ============================================================================
#  Modele de secrets pour la demo Streamlit Community Cloud.
#
#  IMPORTANT : ce fichier est un EXEMPLE (il est commite).
#  Le vrai fichier .streamlit/secrets.toml est IGNORE par git.
#  Sur Streamlit Cloud, renseignez plutot ces memes cles dans
#  Settings > Secrets de votre application (ne commitez jamais de secret).
#
#  Pour tester en local : copiez ce fichier en .streamlit/secrets.toml
# ============================================================================

# --- Backend : la demo publique utilise uniquement le cloud -----------------
IDP_PROVIDER = "vertex"

# --- Google Vertex AI -------------------------------------------------------
VERTEX_PROJECT_ID = "votre-id-de-projet-gcp"
VERTEX_LOCATION = "us-central1"
VERTEX_MODEL = "gemini-2.5-pro"

# --- Compte de service Google (a coller tel quel, JSON complet) --------------
# Collez ici le CONTENU du fichier JSON du compte de service (entre les
# triples apostrophes). Ne le mettez jamais dans un fichier public.
GCP_SERVICE_ACCOUNT_JSON = '''
{
  "type": "service_account",
  "project_id": "votre-projet",
  "private_key_id": "REMPLACER",
  "private_key": "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n",
  "client_email": "mon-compte@mon-projet.iam.gserviceaccount.com",
  "client_id": "REMPLACER",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token"
}
'''

# --- Quotas de la demo publique ----------------------------------------------
# 3 essais maximum par visiteur, 50 requetes maximum par mois.
DEMO_QUOTA_ENABLED = true
DEMO_PER_USER_LIMIT = 3
DEMO_MONTHLY_LIMIT = 50
