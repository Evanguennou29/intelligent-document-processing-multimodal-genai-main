# ---------------------------------------------------------------------------
#  Copiez ce fichier en .env, puis adaptez les valeurs :
#      cp .env.example .env        (Windows : copy .env.example .env)
#
#  Le fichier .env est ignore par git : ne mettez JAMAIS de secret dedans
#  de maniere a le commiter, et ne commitez jamais .env.
# ---------------------------------------------------------------------------

# Backend utilise par defaut : vertex (cloud) ou ollama (local)
IDP_PROVIDER=ollama

# --- Google Vertex AI ------------------------------------------------------
# Identifiant de votre projet Google Cloud (obligatoire en mode vertex).
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-pro

# --- Ollama (local) --------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_TEXT_MODEL=llama3.2
OLLAMA_TIMEOUT=180
OLLAMA_MAX_IMAGE_SIDE=1024

# --- Comportement ----------------------------------------------------------
IDP_MAX_RETRIES=2
IDP_RETRY_BACKOFF=1.5
IDP_USE_CACHE=true
IDP_LOG_LEVEL=INFO

# --- Stockage (chemins relatifs a la racine du projet) ---------------------
# IDP_RAW_DIR=data/raw
# IDP_PROCESSED_DIR=data/processed
# IDP_CACHE_DIR=.cache/idp

# --- Limites d'entree ------------------------------------------------------
IDP_MAX_UPLOAD_MB=25
IDP_PDF_MAX_PAGES=1
IDP_PDF_DPI=200